<?xml version="1.0"?>
<robot name="omni_robot" xmlns:xacro="http://ros.org/wiki/xacro">

  <material name="gray"><color rgba="0.5 0.5 0.5 1.0"/></material>
  <material name="blue"><color rgba="0.0 0.0 0.8 1.0"/></material>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.5 0.5 0.1"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>

  <xacro:macro name="omni_wheel" params="prefix x y">
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x} ${y} 0" rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <link name="${prefix}_wheel_link">
      <visual>
        <geometry>
          <cylinder radius="0.05" length="0.04"/>
        </geometry>
        <material name="blue"/>
      </visual>
    </link>
  </xacro:macro>

  <xacro:omni_wheel prefix="front_left"  x="0.2"  y="0.2"/>
  <xacro:omni_wheel prefix="front_right" x="0.2"  y="-0.2"/>
  <xacro:omni_wheel prefix="rear_left"   x="-0.2" y="0.2"/>
  <xacro:omni_wheel prefix="rear_right"  x="-0.2" y="-0.2"/>

  <xacro:include filename="ros2_control.xacro" />

</robot>
