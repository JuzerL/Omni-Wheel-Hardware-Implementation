<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Single wheel macro -->
  <xacro:macro name="wheel" params="name x y">

    <link name="${name}_link">
      <visual>
        <geometry>
          <cylinder radius="0.05" length="0.03"/>
        </geometry>
        <material name="black"/>
      </visual>

      <collision>
        <geometry>
          <cylinder radius="0.05" length="0.03"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.001" iyy="0.001" izz="0.001"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} -0.05" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

  </xacro:macro>


  <!-- All wheels -->
  <xacro:macro name="wheels">

    <!-- Front Left -->
    <xacro:wheel name="wheel_fl" x="0.15" y="0.15"/>

    <!-- Front Right -->
    <xacro:wheel name="wheel_fr" x="0.15" y="-0.15"/>

    <!-- Rear Left -->
    <xacro:wheel name="wheel_rl" x="-0.15" y="0.15"/>

    <!-- Rear Right -->
    <xacro:wheel name="wheel_rr" x="-0.15" y="-0.15"/>

  </xacro:macro>

</robot><?xml version="1.0"?>
